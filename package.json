{
  "name": "herdcall",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:localhost": "hardhat run scripts/deploy.js --network localhost",
    "deploy:testnet": "hardhat run scripts/deploy.js --network monadTestnet",
    "node": "hardhat node",
    "sim": "node sim/run.js",
    "test:sim": "node --test sim/stampede.test.js sim/rekt-mining.test.js sim/curve.test.js sim/name-bond.test.js sim/lp-reinvest.test.js",
    "sim:rekt": "node sim/rekt-run.js",
    "test:mirror": "node --test src/lib/mirror.test.js",
    "sim:curve": "node sim/curve-run.js",
    "sim:names": "node sim/name-bond-run.js",
    "sim:reinvest": "node sim/lp-reinvest-run.js",
    "vectors": "node sim/vectors.js",
    "idl": "node programs/idl/build.mjs",
    "test:client": "node --test scripts/herdcall-client.test.mjs",
    "validator:local": "scripts/local-validator.sh",
    "flow": "node scripts/launch-flow.mjs",
    "keeper": "node scripts/keeper/keeper.mjs",
    "test:keeper": "node --test scripts/keeper/logic.test.mjs scripts/keeper/monitor.test.mjs",
    "test:core": "cd programs/herdcall-core && cargo test",
    "test:program": "cd programs && (ls fixtures/*.so >/dev/null 2>&1 || ./fixtures/fetch.sh) && cargo build-sbf --manifest-path herdcall/Cargo.toml && cargo test -p herdcall-tests",
    "test:web": "node scripts/web-e2e.mjs"
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.1",
    "@noble/hashes": "^1.3.2",
    "@openzeppelin/contracts": "^5.4.0",
    "buffer": "^6.0.3",
    "dotenv": "^17.3.1",
    "ethers": "^6.16.0",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.3"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.24",
    "hardhat": "^3.1.8",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "vite": "^5.0.0"
  },
  "description": "HerdCall - Solana community launchpad. No snipers. Just the herd."
}
